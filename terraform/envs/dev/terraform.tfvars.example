aws_region     = "ap-south-1"
env            = "dev"
project        = "mr-reviewer"
vpc_cidr       = "10.40.0.0/16"
db_username    = "mr_reviewer"
watched_repos  = "my-org/terraform-infra,my-org/gitops"

# EKS POC: single small managed node
node_instance_type = "t3.medium"
node_desired_size  = 1
cluster_version    = "1.34"

# Argo CD root Application source (change to your fork/remote)
git_repo_url      = "https://github.com/Hit45man/AI-MR-Reviewer.git"
git_repo_revision = "HEAD"

# Shared VPC is owned by terraform/envs/atlantis-poc (modules/networking).
# These point at that remote state — required before Atlantis can apply this stack.
atlantis_poc_state_bucket = "mr-reviewer-dev-tfstate"
atlantis_poc_state_key    = "atlantis-poc/terraform.tfstate"
state_lock_table_name     = "mr-reviewer-dev-tfstate-lock"

# Atlantis server lives in terraform/envs/atlantis-poc. Keep false here.
enable_atlantis = false
atlantis_instance_type  = "t3.small"
atlantis_repo_allowlist = "github.com/Hit45man/AI-MR-Reviewer"
atlantis_key_name         = ""
atlantis_ssh_cidr_blocks  = []
tags = {
  env         = "dev"
  team        = "platform"
  workload    = "mr-reviewer"
  cost-center = "cc-platform"
  data-class  = "confidential"
  managed-by  = "terraform"
}
