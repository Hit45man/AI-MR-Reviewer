# Local only — copy from terraform.tfvars.example. Gitignored via *.tfvars.

aws_region   = "ap-south-1"
project      = "mr-reviewer"
env          = "atlantis" # Atlantis resource name prefix
platform_env = "dev"      # modules/networking naming + shared with envs/dev
vpc_cidr     = "10.40.0.0/16"
# eks_cluster_name = "mr-reviewer-dev"  # optional; default = project-platform_env

state_bucket_name     = "mr-reviewer-dev-tfstate"
state_lock_table_name = "mr-reviewer-dev-tfstate-lock"
kms_key_arn           = ""

atlantis_instance_type       = "t3.small"
atlantis_root_volume_gb      = 30
atlantis_image               = "ghcr.io/runatlantis/atlantis:v0.30.0"
atlantis_repo_allowlist      = "github.com/Hit45man/AI-MR-Reviewer"
atlantis_webhook_cidr_blocks = ["0.0.0.0/0"]
atlantis_attach_admin_access = true
atlantis_key_name            = ""
atlantis_ssh_cidr_blocks     = []

# Prefer Secrets Manager after apply — leave GitHub creds empty here

tags = {
  env        = "atlantis"
  team       = "platform"
  workload   = "atlantis-poc"
  managed-by = "terraform"
}
